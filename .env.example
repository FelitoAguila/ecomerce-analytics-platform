# Postgres OLTP DSN (Neon).
POSTGRES_DB__DSN=postgresql://<user>:<password>@<host>/olist_db

# Neon Object Storage (S3-compatible) holding the Olist CSVs. Required by `make seed`.
# Create a bucket named `olist-dataset` and upload the 9 CSVs as flat keys.
# See packages/ecommerce_db/README.md for the full setup.
OBJECT_STORAGE__AWS_ENDPOINT_URL_S3=https://<region>.storage.<cloud>.aws.neon.tech
OBJECT_STORAGE__AWS_ACCESS_KEY_ID=<your-access-key-id>
OBJECT_STORAGE__AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
OBJECT_STORAGE__AWS_REGION=<your-region>
# Optional — defaults to olist-dataset
# OBJECT_STORAGE__BUCKET=olist-dataset

# BigQuery warehouse (dlt target + dbt + dashboard).
BIGQUERY__PROJECT=<gcp-project-id>
BIGQUERY__LOCATION=us-central1
BIGQUERY__KEYFILE=/absolute/path/to/service-account.json

# Optional pipeline settings (defaults shown)
# PIPELINE__NAME=ecommerce_pipeline
# PIPELINE__DATASET_NAME=bronze_data
# PIPELINE__RECONCILE_NAME=ecommerce_pipeline_reconcile
# PIPELINE__RECONCILE_DATASET_NAME=bronze_reconcile

# Optional: override the gold tables the dashboard reads.
# BigQuery names are <dataset>.<table>; fully-qualified with the project is
# also accepted (project.dataset.table).
# DASHBOARD__FCT_ORDERS=mart.fct_orders
# DASHBOARD__FCT_ORDER_PAYMENTS=mart.fct_order_payments
# DASHBOARD__DIM_PRODUCTS=mart.dim_products
# DASHBOARD__DIM_SELLERS=mart.dim_sellers
# DASHBOARD__DIM_CUSTOMERS=mart.dim_customers
# DASHBOARD__ORDERS_SNAPSHOT=snapshots.orders_snapshot
# DASHBOARD__GEOLOCATION=int.int_geolocation_aggregated
# DASHBOARD__ORDER_ITEMS=int.int_order_items_enriched
