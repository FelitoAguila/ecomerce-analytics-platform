ECOMMERCE_DB__DSN=postgresql://user:pass@localhost:5432/db

# Local DuckDB warehouse. Read by config.py AND dbt/profiles.yml (env_var).
# Must be an ABSOLUTE, machine-valid path: Python runs from repo root while dbt
# runs from src/olist/pipeline/dbt, so a relative value would resolve to
# different files. Use a Linux path on WSL, Windows path on native Windows.
WAREHOUSE_LOCAL__PATH=/absolute/path/to/data/warehouse/ecommerce.duckdb