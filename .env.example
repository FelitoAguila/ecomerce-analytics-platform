# Local Ecommerce PostgresDB DSN
POSTGRES_DB__DSN=postgresql://postgres:postgres@localhost:5432/ecommerce

# Local DuckDB warehouse file (used by the dlt pipeline and dbt).
# Optional — unset, both default to <repo-root>/data/warehouse/ecommerce.duckdb.
# WAREHOUSE_LOCAL__PATH=/absolute/path/to/olist-ecommerce/data/warehouse/ecommerce.duckdb

# Optional pipeline settings (defaults shown)
# PIPELINE__NAME=ecommerce_pipeline
# PIPELINE__DATASET_NAME=ecommerce_data

# Dashboard read source — duckdb (local file) or bigquery (Phase 7).
# Switching is config-only: same SQL, table names point at the active warehouse.
# DASHBOARD__SOURCE=duckdb
#
# Optional: override the fully-qualified gold tables the dashboard reads.
# BigQuery example: DASHBOARD__FCT__ORDERS=olist-analytics.mart.fct_orders
# DASHBOARD__FCT__ORDERS=main_mart.fct_orders
# DASHBOARD__FCT__ORDER_PAYMENTS=main_mart.fct_order_payments
# DASHBOARD__DIM_PRODUCTS=main_mart.dim_products
# DASHBOARD__DIM_SELLERS=main_mart.dim_sellers
# DASHBOARD__DIM_CUSTOMERS=main_mart.dim_customers
# DASHBOARD__ORDERS_SNAPSHOT=main_snapshots.orders_snapshot
# DASHBOARD__GEOLOCATION=main_int.int_geolocation_aggregated
# DASHBOARD__ORDER_ITEMS=main_int.int_order_items_enriched